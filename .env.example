# Copy to `.env` and fill in real values. NEVER commit `.env` to git.
# cp .env.example .env && chmod 600 .env

# User/group IDs the linuxserver containers run as (id -u / id -g on the host)
PUID=1000
PGID=1000

# Timezone for container logs/scheduling
TZ=America/Chicago

# This host's Tailscale IP. Sensitive web UIs (Homepage, FileBrowser,
# Uptime Kuma, Beszel) bind to this address only — never 0.0.0.0.
TAILSCALE_IP=100.x.x.x

# --- NordVPN (Gluetun) ---
# NORDVPN_USER is a Nord Account API token (from the Nord Account dashboard).
# Derive the WireGuard private key from it:
#   curl -s -u "token:<NORDVPN_USER>" https://api.nordvpn.com/v1/users/services/credentials
NORDVPN_USER=
NORDVPN_PASS=token
WIREGUARD_PRIVATE_KEY=

# --- Plex ---
# Claim token from https://www.plex.tv/claim/ — expires ~4 minutes after
# generating, so grab it right before the first `docker compose up -d`.
PLEX_CLAIM=

# --- FileBrowser (Quantum fork) ---
FILEBROWSER_ADMIN_PASSWORD=

# --- Beszel agent ---
# From the Beszel hub UI: create the admin account, Add System, paste the
# TOKEN and KEY shown. Then `docker compose up -d beszel-agent`.
BESZEL_TOKEN=
BESZEL_KEY=
